# Public FormSubmit replacement identifier from the activation email (identifier only, not a URL).
# Set this in Cloudflare Pages for Preview and Production, then redeploy.
# Until configured, the form temporarily falls back to the activated info@satsb.com.my endpoint.
VITE_FORM_SUBMIT_ID=

# Optional future custom HTTPS form endpoint. When set, this overrides FormSubmit.
VITE_CONTACT_FORM_ENDPOINT=
VITE_SITE_URL=https://www.satsb.com.my
